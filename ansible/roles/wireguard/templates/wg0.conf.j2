# Managed by Ansible (roles/wireguard) - docs/vpn.md.
#
# No PrivateKey and no peers in this file, so Ansible never has to read a
# key or overwrite a peer: the key is set from server.key, and the peers
# are loaded from peers.conf, which only wg-peer edits.
[Interface]
Address = {{ wireguard_address }}
ListenPort = {{ wireguard_port }}
PostUp = wg set %i private-key /etc/wireguard/server.key
PostUp = wg addconf %i /etc/wireguard/peers.conf
# Phones reach the Mac as if from the Pi, so the Mac's replies come back
# here (its default route is the router, which has never heard of 10.8.0.0/24).
PostUp = iptables -t nat -A POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_lan_interface }} -j MASQUERADE
PostDown = iptables -t nat -D POSTROUTING -s {{ wireguard_network }} -o {{ wireguard_lan_interface }} -j MASQUERADE
