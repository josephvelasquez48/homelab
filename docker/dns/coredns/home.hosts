# Internal service hostnames. All of these route through Traefik (K3s's
# bundled ingress controller, listening on :80 on every node) to the
# matching in-cluster Service - no port needed in any of these URLs.
192.168.1.253 api.home
192.168.1.253 ai.home
192.168.1.253 grafana.home
192.168.1.253 argocd.home
