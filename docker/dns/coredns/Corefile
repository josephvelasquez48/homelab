# Internal zone: *.home hostnames, served straight from a hosts file.
# No fallthrough - anything under .home not listed here is NXDOMAIN.
home:53 {
    hosts /etc/coredns/home.hosts
    log
    errors
}

# Everything else: block known ad/tracking domains, forward the rest upstream.
.:53 {
    hosts /etc/coredns/blocklist.hosts {
        fallthrough
    }
    forward . 1.1.1.1 8.8.8.8
    cache 30
    log
    errors
}
