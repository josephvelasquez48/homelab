# Internal zone: *.home hostnames, served straight from a hosts file.
# No fallthrough - anything under .home not listed here is NXDOMAIN.
home:53 {
    hosts /etc/coredns/home.hosts
    log
    errors
}

# Everything else: hand off to AdGuard Home (127.0.0.1:5353, same host,
# network_mode: host) for ad/tracker filtering + its own upstream
# forwarding, instead of forwarding to a public resolver directly. The
# StevenBlack hosts-file blocklist this used to load lives in AdGuard's
# own filter config now - see docker/dns/README.md.
.:53 {
    forward . 127.0.0.1:5353
    cache 30
    log
    errors
}
